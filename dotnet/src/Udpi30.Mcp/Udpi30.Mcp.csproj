<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Udpi30.Mcp</RootNamespace>
    <AssemblyName>udpi30-mcp</AssemblyName>

    <!-- Packaged and installed as a global .NET tool: `dotnet tool install -g udpi30-mcp` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>udpi30-mcp</ToolCommandName>
    <PackageId>udpi30-mcp</PackageId>
    <Description>MCP server exposing UDPI30 operations as tools for Claude Code, Cursor, and other MCP clients.</Description>
    <PackageTags>microsoft-fabric;mcp;model-context-protocol;udpi30</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Templates ship dotfiles (.gitignore) that the packer excludes by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Udpi30.Core\Udpi30.Core.csproj" />
  </ItemGroup>

</Project>
