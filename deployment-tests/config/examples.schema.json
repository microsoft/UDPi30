{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udpi30.dev/schemas/deployment-tests/examples.schema.json",
  "title": "UDP deployment example inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "examples"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "examples": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "defaultTarget", "supportLevel", "executionMode", "planes", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^(0[1-9]|1[0-4])$" },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^examples/" },
          "defaultTarget": { "type": "string", "minLength": 1 },
          "supportLevel": {
            "enum": ["deployable", "deployable-with-inputs", "validation-only", "admin-plan-only", "contract-only"]
          },
          "executionMode": { "enum": ["deployment", "admin"] },
          "planes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "cleanupMode": { "enum": ["destroy", "restore-snapshot", "none"] }
        }
      }
    }
  }
}
